{
  "name": "@oh-my-opencode/moa-core",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Harness-neutral Mixture of Advisors core: presets, prompt registry, context bounding, output contracts, state machine, diversity policy, and the execution adapter port.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config/index.ts",
      "import": "./src/config/index.ts"
    },
    "./presets": {
      "types": "./src/presets/index.ts",
      "import": "./src/presets/index.ts"
    },
    "./prompts": {
      "types": "./src/prompts/index.ts",
      "import": "./src/prompts/index.ts"
    },
    "./context": {
      "types": "./src/context/index.ts",
      "import": "./src/context/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "import": "./src/contracts/index.ts"
    },
    "./state": {
      "types": "./src/state/index.ts",
      "import": "./src/state/index.ts"
    },
    "./diversity": {
      "types": "./src/diversity/index.ts",
      "import": "./src/diversity/index.ts"
    },
    "./adapter": {
      "types": "./src/adapter/index.ts",
      "import": "./src/adapter/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "bun test src/*.test.ts src/**/*.test.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "sideEffects": false
}
